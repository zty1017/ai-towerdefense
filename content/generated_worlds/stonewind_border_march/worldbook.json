  "npc_archetypes": [
    {
      "stable_internal_id": "commander_aldric",
      "display_name": "阿尔德里克指挥官",
      "role": "城堡指挥官",
      "voice": "头发花白的退伍军人，语气沉稳但焦急。‘边境的每一块石头都在颤抖，我们得守住。’"
    },
    {
      "stable_internal_id": "mira_the_alchemist",
      "display_name": "炼金术士米拉",
      "role": "炼金工坊负责人",
      "voice": "年轻而狂热，说话带着实验记录般的精确。‘只要再给我一束炼金草，就能让那火焰喷射器稳定运转。’"
    },
    {
      "stable_internal_id": "old_lorne",
      "display_name": "老洛恩",
      "role": "巡林者向导",
      "voice": "沉默寡言，偶尔用沙哑的嗓音给出最实用的建议。‘沼泽里的路会动，跟着石头上的苔藓走。’"
    }
  ],
