{
  "schema_version": "workflow_graph.v0.1",
  "workflow_id": "temporary_mod_compile_graph",
  "mode": "live",
  "description": "Object-level compile template for Temporary Mod assets. Loads a temporary mod proposal, validates it, compiles with LLM guard, validates candidate, simulates, scores, evaluates promotion, and produces a pipeline summary.",
  "nodes": [
    {
      "id": "load_proposal",
      "node_type": "source.load_json",
      "params": { "path": "{{proposal_path}}" }
    },
    {
      "id": "validate_proposal",
      "node_type": "proposal.validate"
    },
    {
      "id": "llm_compile",
      "node_type": "asset.compile_with_llm_guarded",
      "params": {
        "allow_live_provider_call": true,
        "provider_profile": "{{provider_profile}}",
        "max_tokens": 8192,
        "request_timeout": 240
      }
    },
    {
      "id": "validate_candidate",
      "node_type": "asset.validate_candidate"
    },
    {
      "id": "simulate",
      "node_type": "asset.simulate_candidate",
      "params": { "duration_seconds": 30.0 }
    },
    {
      "id": "score",
      "node_type": "asset.score_candidate"
    },
    {
      "id": "promotion",
      "node_type": "asset.evaluate_promotion_policy"
    },
    {
      "id": "summary",
      "node_type": "report.pipeline_summary"
    }
  ],
  "edges": [
    { "source": "load_proposal", "target": "validate_proposal", "target_input": "proposal" },
    { "source": "load_proposal", "target": "llm_compile", "target_input": "proposal" },
    { "source": "llm_compile", "target": "validate_candidate", "target_input": "candidate" },
    { "source": "llm_compile", "target": "simulate", "target_input": "candidate" },
    { "source": "llm_compile", "target": "score", "target_input": "candidate" },
    { "source": "validate_candidate", "target": "score", "target_input": "validation" },
    { "source": "simulate", "target": "score", "target_input": "simulation" },
    { "source": "llm_compile", "target": "promotion", "target_input": "candidate" },
    { "source": "validate_candidate", "target": "promotion", "target_input": "validation" },
    { "source": "simulate", "target": "promotion", "target_input": "simulation" },
    { "source": "score", "target": "promotion", "target_input": "candidate_score" },
    { "source": "validate_proposal", "target": "summary", "target_input": "proposal_validation" },
    { "source": "validate_candidate", "target": "summary", "target_input": "candidate_validation" },
    { "source": "simulate", "target": "summary", "target_input": "simulation" },
    { "source": "score", "target": "summary", "target_input": "candidate_score" },
    { "source": "promotion", "target": "summary", "target_input": "asset_promotion" }
  ]
}
