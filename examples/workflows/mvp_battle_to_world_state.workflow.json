{
  "schema_version": "workflow_graph.v0.1",
  "workflow_id": "mvp_battle_to_world_state",
  "mode": "deterministic",
  "description": "battle result -> narrative -> WorldStateDelta -> next RunWorldState: first complete closed loop",
  "nodes": [
    {
