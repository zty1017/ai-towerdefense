{
  "schema_version": "workflow_graph.v0.1",
  "workflow_id": "mvp_live_world_delta_guarded",
  "mode": "live",
  "description": "battle result -> LLM-guarded WorldStateDelta -> next RunWorldState: first live LLM closed loop. WARNING: this workflow calls a real LLM provider. Only execute when you explicitly intend to make live API calls.",
  "nodes": [
    {
      "id": "load_run_state",
      "node_type": "source.load_json",
      "params": { "path": "examples/run_world_states/demo_initial.run_world_state.json" }
    },
    {
      "id": "load_battle_result",
      "node_type": "source.load_json",
      "params": { "path": "examples/asset_graph/battle_result.sample.json" }
    },
    {
      "id": "load_session_context",
      "node_type": "source.load_json",
      "params": { "path": "examples/asset_graph/session_context.sample.json" }
    },
    {
      "id": "build_delta",
      "node_type": "world_state.build_delta_with_llm_guarded",
      "params": {
        "allow_live_provider_call": true,
        "provider_profile": "ark_deepseek_v4_flash",
        "max_tokens": 4096,
        "request_timeout": 90
      }
    },
    {
      "id": "semantic_gate",
      "node_type": "world_state.validate_delta_semantics"
    },
    {
      "id": "apply_delta",
      "node_type": "world_state.apply_delta"
    }
  ],
  "edges": [
    { "source": "load_run_state", "target": "build_delta", "target_input": "run_world_state" },
    { "source": "load_battle_result", "target": "build_delta", "target_input": "battle_result" },
    { "source": "load_session_context", "target": "build_delta", "target_input": "session_context" },
    { "source": "load_run_state", "target": "semantic_gate", "target_input": "run_world_state" },
    { "source": "build_delta", "target": "semantic_gate", "target_input": "world_state_delta" },
    { "source": "load_run_state", "target": "apply_delta", "target_input": "run_world_state" },
    { "source": "semantic_gate", "target": "apply_delta", "target_input": "world_state_delta" }
  ]
}
