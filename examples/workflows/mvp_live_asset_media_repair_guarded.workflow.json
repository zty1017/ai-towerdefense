{
  "schema_version": "workflow_graph.v0.1",
  "workflow_id": "mvp_live_asset_media_repair_guarded",
  "mode": "live",
  "description": "LIVE guarded media repair loop: generate media -> deterministic/vision review -> build repair plan -> regenerate failed roles -> merge -> re-review. WARNING: calls real image and vision providers.",
  "nodes": [
    {
      "id": "load_candidate",
      "node_type": "source.load_json",
      "params": {
        "path": "examples/compiled_assets/mirror_lure_trap.compiled_asset.json"
      }
    },
    {
      "id": "generate_images",
      "node_type": "media.generate_asset_images_guarded",
      "params": {
        "allow_live_provider_call": true,
        "image_profile": "agnes_image_flash",
        "size": "1024x1024",
        "roles": "auto",
        "request_timeout": 180
      }
    },
    {
      "id": "visual_identity",
      "node_type": "media.build_visual_identity_spec"
    },
    {
      "id": "quality",
      "node_type": "media.check_quality"
    },
    {
      "id": "consistency",
      "node_type": "media.check_consistency"
    },
    {
      "id": "vision_review",
      "node_type": "media.review_with_vision_guarded",
      "params": {
        "allow_live_provider_call": true,
        "vision_profile": "glm_5v_turbo",
        "max_images": 4,
        "max_tokens": 4096,
        "request_timeout": 240
      }
    },
    {
      "id": "repair_plan",
      "node_type": "media.build_prompt_repair_plan"
    },
    {
      "id": "regenerate_failed_roles",
      "node_type": "media.generate_asset_images_guarded",
      "params": {
        "allow_live_provider_call": true,
        "image_profile": "agnes_image_flash",
        "size": "1024x1024",
        "roles": "repair_failed",
        "request_timeout": 180
      }
    },
    {
      "id": "merge_repair",
      "node_type": "media.merge_repaired_sequence"
    },
    {
      "id": "quality_after_repair",
      "node_type": "media.check_quality"
    },
    {
      "id": "consistency_after_repair",
      "node_type": "media.check_consistency"
    },
    {
      "id": "vision_review_after_repair",
      "node_type": "media.review_with_vision_guarded",
      "params": {
        "allow_live_provider_call": true,
        "vision_profile": "glm_5v_turbo",
        "max_images": 4,
        "max_tokens": 4096,
        "request_timeout": 240
      }
    },
    {
      "id": "remove_bg",
      "node_type": "media.remove_background_stub"
    },
    {
      "id": "crop_pad",
      "node_type": "media.crop_and_pad_stub"
    },
    {
      "id": "normalize",
      "node_type": "media.normalize_canvas_stub"
    },
    {
      "id": "assign_anchor",
      "node_type": "media.assign_anchor_stub"
    },
    {
      "id": "pack_sheet",
      "node_type": "media.pack_sprite_sheet_stub"
    },
    {
      "id": "build_atlas",
      "node_type": "media.build_atlas_json_stub",
      "runtime_public": true
    }
  ],
