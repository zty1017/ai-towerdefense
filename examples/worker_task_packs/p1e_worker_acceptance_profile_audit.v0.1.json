  ],
  "forbidden_paths": [
    ".env",
    "backend/",
    "frontend/",
    "examples/review_packs/",
    "game_data/",
    "content/",
    "examples/map_runtime_packages/",
    "examples/map_runtime_packages_v02/",
    "package.json",
    "package-lock.json",
    "requirements.txt",
    "pyproject.toml"
  ],
  "acceptance_commands": [
    "PYTHONPYCACHEPREFIX=/tmp/ai_td_pycache_worker_acceptance_audit python3 -m py_compile tools/dev/audit_common.py tools/dev/audit_worker_acceptance_profiles.py tools/dev/run_worker_acceptance_profile.py tools/dev/validate_worker_task_pack.py",
    "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_audit_report.json --max-samples 8",
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_profile_audit.v0.1.json",
    "python3 tools/dev/run_worker_acceptance_profile.py examples/worker_task_packs/p1e_worker_acceptance_profile_audit.v0.1.json --profile daily_fast --output /tmp/worker_acceptance_profile_audit_runner.json",
    "python3 tools/dev/run_fast_quality_gate.py --output /tmp/worker_acceptance_profile_audit_fast_gate.json",
    "git diff --check"
  ],
  "acceptance_profile": {
    "default_profile": "daily_fast",
    "profiles": {
      "daily_fast": {
        "description": "本地交接前的只读审计快速检查。",
        "commands": [
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_profile_audit.v0.1.json",
          "PYTHONPYCACHEPREFIX=/tmp/ai_td_pycache_worker_acceptance_audit_runner python3 -m py_compile tools/dev/audit_common.py tools/dev/audit_worker_acceptance_profiles.py tools/dev/run_worker_acceptance_profile.py tools/dev/validate_worker_task_pack.py",
          "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_audit_runner_report.json --max-samples 8",
          "git diff --check"
        ],
        "required_for": [
          "daily_small_changes",
          "pre_handoff_sanity"
        ]
      },
      "full_evidence": {
        "description": "最终审查前的完整证据检查：在审计之外运行完整 demo evidence export。",
        "commands": [
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_profile_audit.v0.1.json",
          "PYTHONPYCACHEPREFIX=/tmp/ai_td_pycache_worker_acceptance_audit_full python3 -m py_compile tools/dev/audit_common.py tools/dev/audit_worker_acceptance_profiles.py tools/dev/run_worker_acceptance_profile.py tools/dev/validate_worker_task_pack.py",
          "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_audit_report.json --max-samples 20",
          "python3 tools/demo/export_evidence.py --output-dir /tmp/worker_acceptance_profile_audit_full_evidence",
          "git diff --check"
        ],
        "required_for": [
          "final_review",
          "merge_readiness_without_recording"
        ]
      }
    }
  },
  "reporting_requirements": [
    "modified_files",
    "key_behavior",
    "acceptance_results",
    "protected_files_touched",
    "new_dependencies",
    "unresolved_risks"
  ],
  "safety_rules": {
    "may_read_env": false,
    "may_print_secrets": false,
    "may_store_raw_prompt": false,
    "may_store_provider_response": false,
    "may_bypass_schema_or_semantic_gates": false,
    "may_direct_merge_main_or_develop": false,
    "may_activate_review_only_artifacts": false,
    "must_preserve_player_immersion": true,
    "must_report_protected_files_touched": true
  },
  "provider_policy": {
    "provider_calls_allowed": false,
    "requires_explicit_user_authorization": true,
    "allowed_profiles": [],
    "max_calls": 0,
    "raw_response_storage": "forbidden"
  },
  "notes": [
    "审计工具只读运行，绝不执行被扫描任务包的 acceptance_commands。",
    "审计报告只给出迁移建议，不修改旧 WorkerTaskPack 文件。",
    "包含 shell-only 语法的命令会被记录为需要人工处理，不会让整个审计中断。"
  ]
}
