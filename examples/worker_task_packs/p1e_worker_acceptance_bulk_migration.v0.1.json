{
  "schema_version": "worker_task_pack.v0.1",
  "task_id": "P1-E-10-worker-acceptance-bulk-migration",
  "title": "WorkerTaskPack acceptance profile bulk migration",
  "task_type": "docs",
  "handoff_mode": "local_codex_safe_fallback",
  "base_branch": "develop",
  "branch": "task/worker-profile-bulk-migration",
  "worktree": "/tmp/ai-td-task-worker-profile-bulk-migration",
  "objective": "使用既有安全迁移器给所有 runner-compatible 的旧 WorkerTaskPack 补 acceptance_profile，批量减少日常验收手动步骤；保留 runner-incompatible heredoc / shell-only 包为人工处理。",
  "required_reading": [
    "docs/CURRENT_ARCHITECTURE_INDEX.md",
    "docs/AI_COMPILATION_SYSTEM_V0_1.md",
    "docs/WORKER_TASK_PACK_V0_1.md",
    "control/TASK_QUEUE.md",
    "tools/dev/migrate_worker_acceptance_profiles.py",
    "tools/dev/audit_worker_acceptance_profiles.py"
  ],
  "allowed_paths": [
    "examples/worker_task_packs/",
    "control/TASK_QUEUE.md"
  ],
  "forbidden_paths": [
    ".env",
    "backend/",
    "frontend/",
    "examples/review_packs/",
    "game_data/",
    "content/",
    "shared/schemas/",
    "examples/map_runtime_packages/",
    "examples/map_runtime_packages_v02/",
    "examples/runtime_packages/",
    "tools/"
  ],
  "acceptance_commands": [
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_bulk_migration.v0.1.json",
    "python3 tools/dev/migrate_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_bulk_migration_after_dry.json",
    "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_bulk_migration_audit.json --max-samples 120",
    "python3 tools/dev/run_fast_quality_gate.py --output /tmp/worker_acceptance_bulk_migration_fast_gate.json",
    "python3 tools/demo/export_evidence.py --output-dir /tmp/worker_acceptance_bulk_migration_full_evidence",
    "git diff --check"
  ],
  "acceptance_profile": {
    "default_profile": "daily_fast",
    "profiles": {
      "daily_fast": {
        "description": "日常快速 profile，验证迁移器已无可自动迁移剩余项、审计统计和 fast gate。",
        "commands": [
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_bulk_migration.v0.1.json",
          "python3 tools/dev/migrate_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_bulk_migration_after_dry.json",
          "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_bulk_migration_audit.json --max-samples 120",
          "python3 tools/dev/run_fast_quality_gate.py --output /tmp/worker_acceptance_bulk_migration_fast_gate.json",
          "git diff --check"
        ],
        "required_for": [
          "daily_small_changes",
          "pre_handoff_sanity"
        ]
      },
      "full_evidence": {
        "description": "最终评审 profile，包含完整 demo evidence export。",
        "commands": [
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_bulk_migration.v0.1.json",
          "python3 tools/dev/migrate_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_bulk_migration_after_dry.json",
          "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_bulk_migration_audit.json --max-samples 120",
          "python3 tools/dev/run_fast_quality_gate.py --output /tmp/worker_acceptance_bulk_migration_fast_gate.json",
          "python3 tools/demo/export_evidence.py --output-dir /tmp/worker_acceptance_bulk_migration_full_evidence",
          "git diff --check"
        ],
        "required_for": [
          "final_review",
          "merge_readiness_without_recording"
        ]
      }
    }
  },
  "reporting_requirements": [
    "modified_files",
    "key_design",
    "acceptance_results",
    "protected_files_touched",
    "new_dependencies",
    "subagent_usage",
    "unresolved_risks"
  ],
  "safety_rules": {
    "may_read_env": false,
    "may_print_secrets": false,
    "may_store_raw_prompt": false,
    "may_store_provider_response": false,
    "may_bypass_schema_or_semantic_gates": false,
    "may_direct_merge_main_or_develop": false,
    "may_activate_review_only_artifacts": false,
    "must_preserve_player_immersion": true,
    "must_report_protected_files_touched": true
  },
  "provider_policy": {
    "provider_calls_allowed": false,
    "requires_explicit_user_authorization": true,
    "allowed_profiles": [],
    "max_calls": 0,
    "raw_response_storage": "forbidden"
  },
  "notes": [
    "本任务只运行既有迁移器写入 runner-compatible 旧任务包，不修改工具脚本、后端、前端、runtime、schema 或 review evidence。",
    "迁移器已经跳过包含 heredoc、shell-only 或 runner-incompatible 命令的任务包；这些仍保留人工处理。",
    "本任务不调用 provider、不读取 .env、不执行被迁移任务包的验收命令。",
    "批量迁移后 migrate dry-run 应显示 would_migrate_count=0，audit 应显示剩余 without_profile/manual_review 均为 16。"
  ]
}
