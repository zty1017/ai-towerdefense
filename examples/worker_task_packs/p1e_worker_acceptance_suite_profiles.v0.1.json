{
  "schema_version": "worker_task_pack.v0.1",
  "task_id": "P1-E-6-worker-acceptance-suite-profiles",
  "title": "Demo suite task pack acceptance profiles",
  "task_type": "implementation",
  "handoff_mode": "local_codex_safe_fallback",
  "base_branch": "develop",
  "branch": "task/worker-acceptance-suite-profiles",
  "worktree": "/tmp/ai-td-task-worker-acceptance-suite-profiles",
  "objective": "把 demo evidence suite 相关任务包里的 shell-only 报告断言收束成标准 validator，并补 acceptance_profile，让 profile runner 能直接运行高频 demo / quality gate 验收。",
  "required_reading": [
    "docs/CURRENT_ARCHITECTURE_INDEX.md",
    "docs/AI_COMPILATION_SYSTEM_V0_1.md",
    "control/TASK_QUEUE.md",
    "docs/WORKER_TASK_PACK_V0_1.md",
    "tools/demo/run_demo_evidence_suite.py",
    "tools/dev/run_worker_acceptance_profile.py",
    "tools/dev/audit_worker_acceptance_profiles.py"
  ],
  "allowed_paths": [
    "tools/demo/validate_demo_evidence_suite_report.py",
    "examples/worker_task_packs/p1d_demo_evidence_suite_runner.v0.1.json",
    "examples/worker_task_packs/p1d_demo_suite_scheduler_pipeline_smoke.v0.1.json",
    "examples/worker_task_packs/p1d_demo_suite_scheduler_runner_selection.v0.1.json",
    "examples/worker_task_packs/p1d_demo_suite_outbox_import_smoke.v0.1.json",
    "examples/worker_task_packs/p1e_worker_acceptance_suite_profiles.v0.1.json",
    "docs/CURRENT_ARCHITECTURE_INDEX.md",
    "control/TASK_QUEUE.md"
  ],
  "forbidden_paths": [
    ".env",
    "backend/",
    "frontend/",
    "examples/review_packs/",
    "game_data/",
    "content/",
    "shared/schemas/",
    "examples/map_runtime_packages/",
    "examples/map_runtime_packages_v02/",
    "examples/runtime_packages/"
  ],
  "acceptance_commands": [
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_suite_profiles.v0.1.json",
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_evidence_suite_runner.v0.1.json",
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_suite_scheduler_pipeline_smoke.v0.1.json",
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_suite_scheduler_runner_selection.v0.1.json",
    "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_suite_outbox_import_smoke.v0.1.json",
    "PYTHONPYCACHEPREFIX=/tmp/ai_td_pycache_suite_profiles python3 -m py_compile tools/demo/validate_demo_evidence_suite_report.py tools/demo/run_demo_evidence_suite.py tools/dev/run_worker_acceptance_profile.py tools/dev/audit_worker_acceptance_profiles.py",
    "python3 tools/demo/run_demo_evidence_suite.py --allow-missing-browser --output-root /tmp/ai_td_suite_profile_check --command-timeout 180",
    "python3 tools/demo/validate_demo_evidence_suite_report.py /tmp/ai_td_suite_profile_check/demo_evidence_suite_report.v0.1.json --allow-browser-unavailable --require-scheduler-pipeline-smoke --require-outbox-import-smoke",
    "python3 tools/dev/run_worker_acceptance_profile.py examples/worker_task_packs/p1d_demo_suite_scheduler_pipeline_smoke.v0.1.json --profile daily_fast --dry-run --output /tmp/p1d_scheduler_pipeline_profile_dry.json",
    "python3 tools/dev/run_worker_acceptance_profile.py examples/worker_task_packs/p1d_demo_suite_outbox_import_smoke.v0.1.json --profile daily_fast --dry-run --output /tmp/p1d_outbox_import_profile_dry.json",
    "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_audit_after_suite_profiles.json --max-samples 20",
    "python3 tools/dev/run_fast_quality_gate.py --output /tmp/suite_profiles_fast_gate.json",
    "git diff --check"
  ],
  "acceptance_profile": {
    "default_profile": "daily_fast",
    "profiles": {
      "daily_fast": {
        "description": "日常快速 profile，验证 suite report validator、四个目标任务包结构、suite 报告和 profile runner dry-run。",
        "commands": [
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_suite_profiles.v0.1.json",
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_evidence_suite_runner.v0.1.json",
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_suite_scheduler_pipeline_smoke.v0.1.json",
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_suite_scheduler_runner_selection.v0.1.json",
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1d_demo_suite_outbox_import_smoke.v0.1.json",
          "PYTHONPYCACHEPREFIX=/tmp/ai_td_pycache_suite_profiles python3 -m py_compile tools/demo/validate_demo_evidence_suite_report.py tools/demo/run_demo_evidence_suite.py tools/dev/run_worker_acceptance_profile.py tools/dev/audit_worker_acceptance_profiles.py",
          "python3 tools/demo/run_demo_evidence_suite.py --allow-missing-browser --output-root /tmp/ai_td_suite_profile_check --command-timeout 180",
          "python3 tools/demo/validate_demo_evidence_suite_report.py /tmp/ai_td_suite_profile_check/demo_evidence_suite_report.v0.1.json --allow-browser-unavailable --require-scheduler-pipeline-smoke --require-outbox-import-smoke",
          "python3 tools/dev/run_worker_acceptance_profile.py examples/worker_task_packs/p1d_demo_suite_scheduler_pipeline_smoke.v0.1.json --profile daily_fast --dry-run --output /tmp/p1d_scheduler_pipeline_profile_dry.json",
          "python3 tools/dev/run_worker_acceptance_profile.py examples/worker_task_packs/p1d_demo_suite_outbox_import_smoke.v0.1.json --profile daily_fast --dry-run --output /tmp/p1d_outbox_import_profile_dry.json",
          "python3 tools/dev/audit_worker_acceptance_profiles.py --output /tmp/worker_acceptance_profile_audit_after_suite_profiles.json --max-samples 20",
          "python3 tools/dev/run_fast_quality_gate.py --output /tmp/suite_profiles_fast_gate.json",
          "git diff --check"
        ],
        "required_for": [
          "daily_small_changes",
          "pre_handoff_sanity"
        ]
      },
      "release_gate": {
        "description": "录屏 / release candidate profile，要求一键 suite 真实浏览器截图完整 captured。",
        "commands": [
          "python3 tools/dev/validate_worker_task_pack.py examples/worker_task_packs/p1e_worker_acceptance_suite_profiles.v0.1.json",
          "PYTHONPYCACHEPREFIX=/tmp/ai_td_pycache_suite_profiles python3 -m py_compile tools/demo/validate_demo_evidence_suite_report.py tools/demo/run_demo_evidence_suite.py",
          "python3 tools/demo/run_demo_evidence_suite.py --output-root /tmp/ai_td_suite_profile_release_check --command-timeout 180",
          "python3 tools/demo/validate_demo_evidence_suite_report.py /tmp/ai_td_suite_profile_release_check/demo_evidence_suite_report.v0.1.json --require-browser-captured --require-scheduler-pipeline-smoke --require-outbox-import-smoke",
          "git diff --check"
        ],
        "required_for": [
          "recording",
          "release_candidate"
        ]
      }
    }
  },
  "reporting_requirements": [
    "modified_files",
    "key_design",
    "acceptance_results",
    "protected_files_touched",
    "new_dependencies",
    "subagent_usage",
    "unresolved_risks"
  ],
  "safety_rules": {
    "may_read_env": false,
    "may_print_secrets": false,
    "may_store_raw_prompt": false,
    "may_store_provider_response": false,
    "may_bypass_schema_or_semantic_gates": false,
    "may_direct_merge_main_or_develop": false,
    "may_activate_review_only_artifacts": false,
    "must_preserve_player_immersion": true,
    "must_report_protected_files_touched": true
  },
  "provider_policy": {
    "provider_calls_allowed": false,
    "requires_explicit_user_authorization": true,
    "allowed_profiles": [],
    "max_calls": 0,
    "raw_response_storage": "forbidden"
  },
  "notes": [
    "本任务不修改 suite runtime 行为，只把报告断言集中到 validator。",
    "daily_fast 允许无本地浏览器降级；release_gate 要求真实浏览器 captured。",
    "本任务不调用 provider，不读取 .env，不修改 runtime 包、后端、前端或 review evidence。"
  ]
}
