# 应用基础配置
APP_DB_PATH=backend/data/app.db
APP_TITLE=AI-Compiled Tower Defense Backend
APP_VERSION=0.1.0

# 本地凭据文件位置。真实 .env 不得提交到 Git。
AI_TD_ENV_FILE=.env

# 文本模型凭据
ARK_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
GLM_API_KEY_FREE=
LONGCAT_API_KEY=

# 图像与多模态凭据。Agnes 支持三把 key 轮换。
AGNES_API_KEY=
AGNES_API_KEY_2=
AGNES_API_KEY_3=

# 玩家研发：live / auto / off
AI_TD_LIVE_COMPILATION=auto
AI_TD_LLM_PROFILE=ark_deepseek_v4_flash
AI_TD_LLM_MAX_TOKENS=8192
AI_TD_LLM_TIMEOUT=120

# 研发对象媒体：live / auto / off
AI_TD_LIVE_MEDIA=auto
AI_TD_RUNTIME_IMAGE_PROFILE=agnes_image_flash
AI_TD_RUNTIME_VISION_PROFILE=agnes_multimodal_flash
AI_TD_MEDIA_MAX_ATTEMPTS=2
AI_TD_MEDIA_MINIMUM_SCORE=0.78
AI_TD_MEDIA_GENERATION_TIMEOUT=45
AI_TD_MEDIA_DOWNLOAD_TIMEOUT=20
AI_TD_MEDIA_REVIEW_TIMEOUT=45
AI_TD_MEDIA_REVIEW_MAX_TOKENS=900
AI_TD_MEDIA_TRANSPORT_RETRIES=2

# 战后世界演化：live / auto / off
AI_TD_LIVE_WORLD_EVOLUTION=auto
AI_TD_WORLD_EVOLUTION_TIMEOUT=45
AI_TD_WORLD_EVOLUTION_MAX_TOKENS=4096

# 可恢复后台 worker
AI_TD_RESEARCH_WORKER_MODE=background
AI_TD_RESEARCH_WORKER_POLL_SECONDS=0.25
AI_TD_RESEARCH_WORKER_STOP_SECONDS=10
AI_TD_MAP_VISUAL_WORKER=auto
AI_TD_MAP_VISUAL_POLL_SECONDS=1

# 可选本地缓存与发布目录；留空时使用项目默认路径。
AI_TD_GENERATED_RUNTIME_MEDIA_DIR=
AI_TD_MAP_VISUAL_CACHE_DIR=
AI_TD_MAP_RUNTIME_CATALOG=
