{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/provider_execution_authorization.v0.1.schema.json",
  "title": "ProviderExecutionAuthorization v0.1",
  "description": "A review-only authorization record that allows a future provider adapter to execute for a specific GenerationExecutorRunRequest. It is not a provider call and does not activate runtime or mutate world state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_ref",
    "created_at",
    "source",
    "authority",
    "authorization",
    "execution_constraints",
    "retention_policy",
    "authorization_builder_safety"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "provider_execution_authorization.v0.1" },
    "authorization_ref": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "run_id",
        "schedule_item_id",
        "object_kind",
        "object_ref",
        "executor_request_id",
        "guard_id",
        "provider_mode",
        "provider_profile",
        "worker_id"
      ],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "schedule_item_id": { "type": "string", "minLength": 1 },
        "object_kind": { "type": "string", "minLength": 1 },
        "object_ref": { "type": "string", "minLength": 1 },
        "executor_request_id": { "type": "string", "minLength": 1 },
        "guard_id": { "type": "string", "minLength": 1 },
        "provider_mode": { "type": "string", "minLength": 1 },
        "provider_profile": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "note": { "type": ["string", "null"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "review_only",
        "provider_execution_authorized",
        "runtime_activation_allowed",
        "world_mutation_allowed",
        "player_visible"
      ],
      "properties": {
        "visibility": { "type": "string", "const": "internal_evidence" },
        "review_only": { "type": "boolean", "const": true },
        "provider_execution_authorized": { "type": "boolean", "const": true },
        "runtime_activation_allowed": { "type": "boolean", "const": false },
        "world_mutation_allowed": { "type": "boolean", "const": false },
        "player_visible": { "type": "boolean", "const": false }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "granted",
        "scope",
        "requires_provider_output_envelope",
        "expires_at"
      ],
      "properties": {
        "status": { "type": "string", "const": "granted_for_provider_adapter" },
        "granted": { "type": "boolean", "const": true },
        "scope": { "type": "string", "const": "provider_adapter_execution_only" },
        "requires_provider_output_envelope": { "type": "boolean", "const": true },
        "expires_at": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "execution_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_count",
        "max_attempts",
        "remaining_attempts",
        "allowed_provider_mode",
        "allowed_provider_profile",
        "required_next_gates"
      ],
      "properties": {
        "attempt_count": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 0 },
        "remaining_attempts": { "type": "integer", "minimum": 0 },
        "allowed_provider_mode": { "type": "string", "minLength": 1 },
        "allowed_provider_profile": { "type": "string", "minLength": 1 },
        "required_next_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_body_storage",
        "provider_body_storage",
        "secret_storage",
        "temporary_url_policy",
        "executor_result_storage"
      ],
      "properties": {
        "prompt_body_storage": { "type": "string", "const": "forbidden" },
        "provider_body_storage": { "type": "string", "const": "forbidden" },
        "secret_storage": { "type": "string", "const": "forbidden" },
        "temporary_url_policy": { "type": "string", "const": "download_then_local_ref_only" },
        "executor_result_storage": { "type": "string", "const": "provider_output_envelope_redacted_only" }
      }
    },
    "authorization_builder_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads_env",
        "calls_provider",
        "stores_prompt_body",
        "stores_provider_body",
        "writes_world_state",
        "activates_runtime"
      ],
      "properties": {
        "reads_env": { "type": "boolean", "const": false },
        "calls_provider": { "type": "boolean", "const": false },
        "stores_prompt_body": { "type": "boolean", "const": false },
        "stores_provider_body": { "type": "boolean", "const": false },
        "writes_world_state": { "type": "boolean", "const": false },
        "activates_runtime": { "type": "boolean", "const": false }
      }
    }
  }
}
