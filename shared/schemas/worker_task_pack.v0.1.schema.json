{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/worker_task_pack.v0.1.schema.json",
  "title": "WorkerTaskPack v0.1",
  "description": "A bounded handoff package for CodeBuddy, OpenCode, Codex headless, or human workers. It defines task scope, required readings, writable paths, acceptance commands, reporting requirements, and safety rules before any worker edits the repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "task_type",
    "handoff_mode",
    "base_branch",
    "branch",
    "worktree",
    "objective",
    "required_reading",
    "allowed_paths",
    "forbidden_paths",
    "acceptance_commands",
    "reporting_requirements",
    "safety_rules",
    "provider_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "worker_task_pack.v0.1" },
    "task_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "task_type": {
      "type": "string",
      "enum": ["implementation", "fix", "test", "docs", "prototype", "review", "research"]
    },
    "handoff_mode": {
      "type": "string",
      "enum": ["codebuddy_ide", "codebuddy_cli", "opencode_headless", "codex_headless", "human_worker", "local_codex_safe_fallback"]
    },
    "base_branch": { "type": "string", "const": "develop" },
    "branch": {
      "type": "string",
      "pattern": "^task/[A-Za-z0-9._/-]+$"
    },
    "worktree": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "required_reading": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "acceptance_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "acceptance_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_profile", "profiles"],
      "properties": {
        "default_profile": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "commands", "required_for"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "required_for": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "reporting_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "safety_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_read_env",
        "may_print_secrets",
        "may_store_raw_prompt",
        "may_store_provider_response",
        "may_bypass_schema_or_semantic_gates",
        "may_direct_merge_main_or_develop",
        "may_activate_review_only_artifacts",
        "must_preserve_player_immersion",
        "must_report_protected_files_touched"
      ],
      "properties": {
        "may_read_env": { "type": "boolean", "const": false },
        "may_print_secrets": { "type": "boolean", "const": false },
        "may_store_raw_prompt": { "type": "boolean", "const": false },
        "may_store_provider_response": { "type": "boolean", "const": false },
        "may_bypass_schema_or_semantic_gates": { "type": "boolean", "const": false },
        "may_direct_merge_main_or_develop": { "type": "boolean", "const": false },
        "may_activate_review_only_artifacts": { "type": "boolean", "const": false },
        "must_preserve_player_immersion": { "type": "boolean", "const": true },
        "must_report_protected_files_touched": { "type": "boolean", "const": true }
      }
    },
    "provider_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_calls_allowed",
        "requires_explicit_user_authorization",
        "allowed_profiles",
        "max_calls",
        "raw_response_storage"
      ],
      "properties": {
        "provider_calls_allowed": { "type": "boolean" },
        "requires_explicit_user_authorization": { "type": "boolean", "const": true },
        "allowed_profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "max_calls": { "type": "integer", "minimum": 0 },
        "raw_response_storage": { "type": "string", "const": "forbidden" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
