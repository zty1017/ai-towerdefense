{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/map_compile_package.v0.2.schema.json",
  "title": "MapCompilePackage v0.2",
  "description": "Compile-time evidence package for map-as-compiled-object. It separates logical gameplay truth, control/composition layers, painted visual candidates, pixel alignment, and quality gates before exporting a runtime-safe MapRuntimePackage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "worldbook_id",
    "node_id",
    "created_at",
    "source_refs",
    "logical_map_layer",
    "control_layer",
    "painted_visual_layer",
    "alignment_layer",
    "quality_gates",
    "export_refs",
    "validation_report"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "map_compile_package.v0.2" },
    "package_id": { "type": "string", "minLength": 1 },
    "worldbook_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_refs": { "$ref": "#/$defs/source_refs" },
    "logical_map_layer": { "$ref": "#/$defs/logical_map_layer" },
    "control_layer": { "$ref": "#/$defs/control_layer" },
    "painted_visual_layer": { "$ref": "#/$defs/painted_visual_layer" },
    "alignment_layer": { "$ref": "#/$defs/alignment_layer" },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/quality_gate" }
    },
    "export_refs": { "$ref": "#/$defs/export_refs" },
    "validation_report": { "$ref": "#/$defs/validation_report" }
  },
  "$defs": {
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battle_config_path",
        "map_runtime_package_path",
        "visual_reference_manifest_path",
        "logic_authority"
      ],
      "properties": {
        "battle_config_path": { "type": "string", "minLength": 1 },
        "map_runtime_package_path": { "type": "string", "minLength": 1 },
        "visual_reference_manifest_path": { "type": "string", "minLength": 1 },
        "logic_authority": {
          "type": "string",
          "enum": ["map_runtime_package", "certified_map_template"]
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "width_cells", "height_cells", "cell_size"],
      "properties": {
        "projection": { "type": "string", "minLength": 1 },
        "width_cells": { "type": "integer", "minimum": 1 },
        "height_cells": { "type": "integer", "minimum": 1 },
        "cell_size": { "type": "integer", "minimum": 1 }
      }
    },
    "logical_map_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "grid",
        "path_route_count",
        "build_slot_count",
        "objective_count",
        "spawn_point_count",
        "path_routes",
        "build_slots",
        "objectives",
        "spawn_points"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "enum": ["runtime_truth"]
        },
        "grid": { "$ref": "#/$defs/grid" },
        "path_route_count": { "type": "integer", "minimum": 1 },
        "build_slot_count": { "type": "integer", "minimum": 1 },
        "objective_count": { "type": "integer", "minimum": 1 },
        "spawn_point_count": { "type": "integer", "minimum": 1 },
        "path_routes": { "type": "array", "minItems": 1 },
        "build_slots": { "type": "array", "minItems": 1 },
        "objectives": { "type": "object" },
        "spawn_points": { "type": "array", "minItems": 1 }
      }
    },
    "control_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "artifacts", "model_instruction_boundary"],
      "properties": {
        "authority": {
          "type": "string",
          "enum": ["reference_only"]
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/visual_artifact" }
        },
        "model_instruction_boundary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "visual_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "role", "url", "local_path", "width", "height", "sha256", "authority"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": [
            "strategic_control_sketch",
            "battle_control_sketch",
            "battle_reference_board",
            "battle_runtime_background",
            "painted_visual_layer"
          ]
        },
        "url": { "type": "string", "pattern": "^/assets/map_visual_reference/.+" },
        "local_path": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authority": {
          "type": "string",
          "enum": ["reference_only", "published_visual_layer", "candidate_visual_layer"]
        }
      }
    },
    "painted_visual_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "status", "artifact", "visual_constraints"],
      "properties": {
        "authority": {
          "type": "string",
          "enum": ["published_visual_layer", "candidate_visual_layer", "missing"]
        },
        "status": {
          "type": "string",
          "enum": ["published", "candidate", "missing", "rejected"]
        },
        "artifact": { "oneOf": [{ "$ref": "#/$defs/visual_artifact" }, { "type": "null" }] },
        "visual_constraints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "alignment_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "reference_size",
        "projection",
        "coordinate_mapping",
        "max_pixel_error",
        "overlay_correction_policy",
        "alignment_status",
        "checkpoints"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "enum": ["runtime_overlay_alignment"]
        },
        "reference_size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "projection": { "type": "string", "minLength": 1 },
        "coordinate_mapping": {
          "type": "string",
          "enum": ["map_runtime_cell_to_visual_plane"]
        },
        "max_pixel_error": { "type": "integer", "minimum": 0 },
        "overlay_correction_policy": {
          "type": "string",
          "enum": ["subtle_runtime_overlay", "manual_repaint_required", "debug_only"]
        },
        "alignment_status": {
          "type": "string",
          "enum": ["passed", "needs_overlay_correction", "failed", "not_checked"]
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/alignment_checkpoint" }
        }
      }
    },
    "alignment_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "kind", "logic_position", "expected_pixel"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["route_start", "route_turn", "route_end", "build_slot", "objective", "spawn_point"]
        },
        "logic_position": { "$ref": "#/$defs/point" },
        "expected_pixel": { "$ref": "#/$defs/point" }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "summary"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["passed", "warning", "failed"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "export_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_runtime_package_path", "frontend_default_visual_role"],
      "properties": {
        "map_runtime_package_path": { "type": "string", "minLength": 1 },
        "frontend_default_visual_role": {
          "type": "string",
          "enum": ["battle_runtime_background", "painted_visual_layer"]
        }
      }
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_status", "runtime_truth_preserved", "player_visual_safe", "gates"],
      "properties": {
        "gate_status": {
          "type": "string",
          "enum": ["passed", "warning", "failed"]
        },
        "runtime_truth_preserved": { "type": "boolean" },
        "player_visual_safe": { "type": "boolean" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/quality_gate" }
        }
      }
    }
  }
}
