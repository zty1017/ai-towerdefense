{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/provider_artifact_staging_manifest.v0.1.schema.json",
  "title": "ProviderArtifactStagingManifest v0.1",
  "description": "A review-only staging manifest for local artifacts referenced by a ProviderOutputEnvelope. It records local refs, gate status, and promotion blockers without claiming runtime readiness or mutating world state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "source_envelope_ref",
    "source_envelope_id",
    "authority",
    "retention_policy",
    "staging_status",
    "staged_artifacts",
    "validation_results",
    "promotion_gate"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "provider_artifact_staging_manifest.v0.1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "source_envelope_ref": { "type": "string", "minLength": 1 },
    "source_envelope_id": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "review_only",
        "runtime_activation_allowed",
        "world_mutation_allowed",
        "player_visible"
      ],
      "properties": {
        "visibility": { "type": "string", "const": "internal_evidence" },
        "review_only": { "type": "boolean", "const": true },
        "runtime_activation_allowed": { "type": "boolean", "const": false },
        "world_mutation_allowed": { "type": "boolean", "const": false },
        "player_visible": { "type": "boolean", "const": false }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_body_storage",
        "provider_body_storage",
        "secret_storage",
        "temporary_url_policy",
        "local_refs_only",
        "runtime_claim_policy"
      ],
      "properties": {
        "prompt_body_storage": { "type": "string", "const": "forbidden" },
        "provider_body_storage": { "type": "string", "const": "forbidden" },
        "secret_storage": { "type": "string", "const": "forbidden" },
        "temporary_url_policy": { "type": "string", "const": "local_ref_required" },
        "local_refs_only": { "type": "boolean", "const": true },
        "runtime_claim_policy": { "type": "string", "const": "forbidden_before_promotion" }
      }
    },
    "staging_status": {
      "type": "string",
      "enum": [
        "no_artifacts_guarded",
        "review_only_artifacts_staged",
        "validation_failed"
      ]
    },
    "staged_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/staged_artifact" }
    },
    "validation_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_envelope_gate",
        "local_ref_gate",
        "schema_gate",
        "media_gate",
        "semantic_gate",
        "human_review"
      ],
      "properties": {
        "source_envelope_gate": { "$ref": "#/$defs/gate_status" },
        "local_ref_gate": { "$ref": "#/$defs/gate_status" },
        "schema_gate": { "$ref": "#/$defs/gate_status" },
        "media_gate": { "$ref": "#/$defs/gate_status" },
        "semantic_gate": { "$ref": "#/$defs/gate_status" },
        "human_review": { "$ref": "#/$defs/gate_status" }
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_allowed",
        "blocked_reason",
        "required_next_gates"
      ],
      "properties": {
        "promotion_allowed": { "type": "boolean", "const": false },
        "blocked_reason": {
          "type": "string",
          "enum": [
            "provider_envelope_required",
            "local_refs_required",
            "validation_required",
            "media_gate_required",
            "semantic_gate_required",
            "human_review_required",
            "promotion_report_required",
            "validation_failed"
          ]
        },
        "required_next_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "staged_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "source_artifact_id",
        "kind",
        "path",
        "content_type",
        "media_layer",
        "role",
        "review_status",
        "runtime_visible",
        "player_visible"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "source_artifact_id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "text_candidate",
            "json_candidate",
            "image_candidate",
            "video_candidate",
            "audio_candidate",
            "mixed_candidate",
            "review_report"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content_type": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "media_layer": {
          "type": "string",
          "enum": [
            "candidate_ref",
            "processed_preview",
            "staging_report"
          ]
        },
        "role": { "type": "string", "minLength": 1 },
        "review_status": {
          "type": "string",
          "enum": [
            "staged_for_review",
            "needs_repair",
            "rejected"
          ]
        },
        "runtime_visible": { "type": "boolean", "const": false },
        "player_visible": { "type": "boolean", "const": false },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gate_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_before_promotion"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "required_before_promotion": { "type": "boolean" },
        "report_ref": { "type": ["string", "null"] },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
