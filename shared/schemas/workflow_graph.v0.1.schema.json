{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/workflow_graph.v0.1.schema.json",
  "title": "WorkflowGraph v0.1",
  "description": "A DAG of node instances and edges. v0.1 forbids cycles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "mode", "nodes", "edges"],
  "properties": {
    "schema_version": { "type": "string", "const": "workflow_graph.v0.1" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "string",
      "enum": ["deterministic", "studio", "live"]
    },
    "description": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "node_type": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "inputs": {
          "type": "object",
          "description": "Map of input_name -> literal value or ArtifactRef object."
        },
        "runtime_public": {
          "type": "boolean",
          "default": false,
          "description": "If true, this node's output artifact may be referenced by the runtime package sent to players."
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "source_output": { "type": "string", "default": "default" },
        "target_input": { "type": "string", "default": "default" }
      }
    }
  }
}
