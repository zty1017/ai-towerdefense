{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/provider_output_envelope.v0.1.schema.json",
  "title": "ProviderOutputEnvelope v0.1",
  "description": "A redacted, review-only envelope for provider execution results or guarded provider intents. It stores safe summaries, artifact refs, validation status, and activation gates, never prompt bodies, provider bodies, secrets, or runtime-ready claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "created_at",
    "source",
    "authority",
    "provider_call",
    "retention_policy",
    "redacted_request_summary",
    "redacted_result_summary",
    "artifact_manifest",
    "validation",
    "activation_gate"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "provider_output_envelope.v0.1" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "schedule_item_id",
        "object_kind",
        "object_ref",
        "provider_profile",
        "provider_mode"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "schedule_item_id": { "type": "string", "minLength": 1 },
        "object_kind": { "type": "string", "minLength": 1 },
        "object_ref": { "type": "string", "minLength": 1 },
        "provider_profile": { "type": "string", "minLength": 1 },
        "provider_mode": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "guard_id": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "review_only",
        "runtime_activation_allowed",
        "world_mutation_allowed",
        "player_visible"
      ],
      "properties": {
        "visibility": { "type": "string", "const": "internal_evidence" },
        "review_only": { "type": "boolean", "const": true },
        "runtime_activation_allowed": { "type": "boolean", "const": false },
        "world_mutation_allowed": { "type": "boolean", "const": false },
        "player_visible": { "type": "boolean", "const": false }
      }
    },
    "provider_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "performed",
        "authorization_required",
        "authorization_granted",
        "authorization_ref"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_performed_guarded",
            "performed_redacted",
            "failed_redacted",
            "cancelled"
          ]
        },
        "performed": { "type": "boolean" },
        "authorization_required": { "type": "boolean", "const": true },
        "authorization_granted": { "type": "boolean" },
        "authorization_ref": { "type": ["string", "null"] },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_body_storage",
        "provider_body_storage",
        "secret_storage",
        "temporary_url_policy"
      ],
      "properties": {
        "prompt_body_storage": { "type": "string", "const": "forbidden" },
        "provider_body_storage": { "type": "string", "const": "forbidden" },
        "secret_storage": { "type": "string", "const": "forbidden" },
        "temporary_url_policy": {
          "type": "string",
          "enum": ["forbidden", "download_then_local_ref_only"]
        }
      }
    },
    "redacted_request_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_class", "input_refs", "policy_notes"],
      "properties": {
        "intent_class": { "type": "string", "minLength": 1 },
        "input_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_ref" }
        },
        "policy_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "request_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "redacted_result_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_kind", "status", "summary"],
      "properties": {
        "result_kind": {
          "type": "string",
          "enum": ["none", "text_candidate", "json_candidate", "image_candidate", "video_candidate", "audio_candidate", "mixed_candidate"]
        },
        "status": {
          "type": "string",
          "enum": ["none", "candidate_ready_for_validation", "candidate_failed", "blocked_before_provider_call"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "result_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "finish_reason": { "type": ["string", "null"] }
      }
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "output_refs", "review_only"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_created", "review_only_artifacts_ready", "validation_failed"]
        },
        "output_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_ref" }
        },
        "review_only": { "type": "boolean", "const": true },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_gate",
        "semantic_gate",
        "media_gate",
        "human_review"
      ],
      "properties": {
        "schema_gate": { "$ref": "#/$defs/gate_status" },
        "semantic_gate": { "$ref": "#/$defs/gate_status" },
        "media_gate": { "$ref": "#/$defs/gate_status" },
        "human_review": { "$ref": "#/$defs/gate_status" }
      }
    },
    "activation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_allowed", "blocked_reason", "required_next_gates"],
      "properties": {
        "activation_allowed": { "type": "boolean", "const": false },
        "blocked_reason": {
          "type": "string",
          "enum": [
            "provider_call_not_performed",
            "validation_required",
            "human_review_required",
            "promotion_required",
            "failed_validation"
          ]
        },
        "required_next_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content_type": { "type": "string" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "media_layer": {
          "type": "string",
          "enum": ["raw_media", "processed_media", "published_media"]
        }
      }
    },
    "gate_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_before_activation"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_run", "passed", "failed", "not_applicable"]
        },
        "required_before_activation": { "type": "boolean" },
        "report_ref": { "type": ["string", "null"] },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
