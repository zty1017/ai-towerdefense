{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/map_compilation_run_report.v0.1.schema.json",
  "title": "MapCompilationRunReport v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "completed_at", "status", "input_fingerprint", "input_ref", "worldbook_id", "node_id", "stages", "output_refs", "provider_execution", "quality", "resume"],
  "properties": {
    "schema_version": {"const": "map_compilation_run_report.v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "failed"]},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_ref": {"type": "string", "minLength": 1},
    "worldbook_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "stages": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "output_refs": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "provider_execution": {"type": "object"},
    "quality": {"type": "object"},
    "resume": {"type": "object"}
  }
}

