{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/layered_map_visual_package.v0.1.schema.json",
  "title": "LayeredMapVisualPackage v0.1",
  "description": "Player-usable layered map visual package compiled from MapRuntimePackage, MapStylePack, and ProceduralMapRenderPlan. It is presentation only; gameplay semantics remain in MapRuntimePackage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "worldbook_id",
    "node_id",
    "created_at",
    "source_refs",
    "runtime_semantics_source",
    "style_source",
    "render_plan_source",
    "canvas",
    "coordinate_projection",
    "usage_policy",
    "media_assets",
    "layers",
    "alignment_report",
    "validation_report"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "layered_map_visual_package.v0.1" },
    "package_id": { "type": "string", "minLength": 1 },
    "worldbook_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_runtime_package_path", "map_style_pack_path", "procedural_map_render_plan_path"],
      "properties": {
        "map_runtime_package_path": { "type": "string", "minLength": 1 },
        "map_style_pack_path": { "type": "string", "minLength": 1 },
        "procedural_map_render_plan_path": { "type": "string", "minLength": 1 }
      }
    },
    "runtime_semantics_source": { "$ref": "#/$defs/source" },
    "style_source": { "$ref": "#/$defs/source" },
    "render_plan_source": { "$ref": "#/$defs/source" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "coordinate_projection": { "$ref": "#/$defs/projection" },
    "usage_policy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "media_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/media_asset" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "alignment_report": { "$ref": "#/$defs/alignment_report" },
    "validation_report": { "$ref": "#/$defs/validation_report" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "authority"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["MapRuntimePackage", "MapStylePack", "ProceduralMapRenderPlan"]
        },
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "authority": {
          "type": "string",
          "enum": ["runtime_semantic_truth", "visual_style", "presentation_plan"]
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "format"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "const": "svg" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "mapping",
        "width_cells",
        "height_cells",
        "base_tile_w",
        "base_tile_h",
        "base_offset_x",
        "base_offset_y"
      ],
      "properties": {
        "projection": { "type": "string", "const": "pseudo3d_oblique" },
        "mapping": {
          "type": "string",
          "const": "frontend_battle_design_space"
        },
        "width_cells": { "type": "integer", "minimum": 1 },
        "height_cells": { "type": "integer", "minimum": 1 },
        "base_tile_w": { "type": "number", "exclusiveMinimum": 0 },
        "base_tile_h": { "type": "number", "exclusiveMinimum": 0 },
        "base_offset_x": { "type": "number" },
        "base_offset_y": { "type": "number" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "role",
        "order",
        "player_default",
        "source",
        "url",
        "local_path",
        "width",
        "height",
        "sha256",
        "quality"
      ],
      "properties": {
        "layer_id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": [
            "terrain_base",
            "terrain_detail",
            "road_shadow",
            "road_edge",
            "road_surface",
            "build_slots",
            "objectives",
            "spawn",
            "semantic_props",
            "non_blocking_decorations",
            "lighting",
            "fog_weather",
            "color_grade",
            "composited"
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "player_default": { "type": "boolean" },
        "source": {
          "type": "string",
          "enum": [
            "map_runtime_package",
            "map_style_pack",
            "procedural_map_render_plan",
            "reviewed_visual_backdrop",
            "derived_composite"
          ]
        },
        "url": { "type": "string", "pattern": "^/assets/(layered_maps|generated_worlds)/.+" },
        "local_path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate_status", "alignment_status", "player_visible_quality"],
          "properties": {
            "gate_status": { "type": "string", "enum": ["passed", "warning", "failed"] },
            "alignment_status": { "type": "string", "enum": ["passed", "warning", "failed"] },
            "player_visible_quality": { "type": "string", "enum": ["passed", "warning", "failed"] }
          }
        }
      }
    },
    "media_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "media_kind",
        "url",
        "local_path",
        "width",
        "height",
        "sha256",
        "usage"
      ],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": [
            "terrain_tile",
            "terrain_detail_tile",
            "road_tile",
            "road_edge_tile",
            "road_detail_atlas",
            "slot_tile",
            "shadow_overlay_tile",
            "fog_overlay_tile",
            "light_overlay_tile",
            "reviewed_painted_backdrop",
            "objective_foundation",
            "spawn_marker",
            "non_blocking_decoration"
          ]
        },
        "media_kind": {
          "type": "string",
          "enum": ["texture_tile_png", "texture_atlas_png", "map_backdrop_png", "component_sprite_png"]
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "procedural_texture",
            "local_ai_exploration_texture",
            "local_ai_exploration_backdrop",
            "compiled_reviewed_texture",
            "compiled_reviewed_backdrop",
            "compiled_reviewed_component"
          ]
        },
        "source_local_path": { "type": "string" },
        "url": { "type": "string", "pattern": "^/assets/(layered_maps|generated_worlds)/.+" },
        "local_path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "usage": {
          "type": "string",
          "enum": ["presentation_texture_only", "presentation_backdrop_only", "presentation_component_only"]
        }
      }
    },
    "alignment_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_status",
        "runtime_truth_preserved",
        "route_count",
        "build_slot_count",
        "objective_count",
        "spawn_count",
        "checks"
      ],
      "properties": {
        "gate_status": { "type": "string", "enum": ["passed", "warning", "failed"] },
        "runtime_truth_preserved": { "type": "boolean", "const": true },
        "route_count": { "type": "integer", "minimum": 0 },
        "build_slot_count": { "type": "integer", "minimum": 0 },
        "objective_count": { "type": "integer", "minimum": 0 },
        "spawn_count": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "status", "summary"],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["passed", "warning", "failed"] },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_status", "player_default_safe", "external_generation_call_count", "gates"],
      "properties": {
        "gate_status": { "type": "string", "enum": ["passed", "warning", "failed"] },
        "player_default_safe": { "type": "boolean" },
        "external_generation_call_count": { "type": "integer", "minimum": 0 },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "status", "summary"],
            "properties": {
              "gate_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["passed", "warning", "failed"] },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
