{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/map_template_catalog.v0.1.schema.json",
  "title": "MapTemplateCatalog v0.1",
  "description": "Developer-side candidate seed catalog for map path templates. It is not a MapRuntimePackage, not a player runtime fact source, and cannot infer gameplay logic from images.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "generated_at",
    "source_policy",
    "summary",
    "templates",
    "usage_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "map_template_catalog.v0.1" },
    "catalog_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_role",
        "runtime_fact_source",
        "player_default_runtime",
        "image_to_logic_inference_allowed",
        "may_modify_map_runtime_package"
      ],
      "properties": {
        "catalog_role": { "type": "string", "const": "developer_side_template_candidate_seed_catalog" },
        "runtime_fact_source": { "type": "boolean", "const": false },
        "player_default_runtime": { "type": "boolean", "const": false },
        "image_to_logic_inference_allowed": { "type": "boolean", "const": false },
        "may_modify_map_runtime_package": { "type": "boolean", "const": false }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_count", "required_template_ids"],
      "properties": {
        "template_count": { "type": "integer", "minimum": 5 },
        "required_template_ids": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/template" }
    },
    "usage_policy": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        { "contains": { "const": "developer_side_candidate_only" } },
        { "contains": { "const": "not_runtime_fact_source" } }
      ],
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "normalized_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "role", "normalized_control_points"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "normalized_control_points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/normalized_point" }
        }
      }
    },
    "semantic_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "rules_summary"],
      "properties": {
        "allowed": { "type": "boolean" },
        "rules_summary": { "type": "string", "minLength": 1 }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_label",
        "description",
        "topology_kind",
        "recommended_node_uses",
        "grid_constraints",
        "route_blueprint",
        "slot_strategy",
        "semantic_hooks",
        "usage_policy"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display_label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "topology_kind": {
          "type": "string",
          "enum": ["single_path", "merge_path", "zigzag_path", "pressure_path", "loop_path"]
        },
        "recommended_node_uses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "grid_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_width_cells", "min_height_cells", "preferred_aspect", "notes"],
          "properties": {
            "min_width_cells": { "type": "integer", "minimum": 6 },
            "min_height_cells": { "type": "integer", "minimum": 5 },
            "preferred_aspect": { "type": "string", "minLength": 1 },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "route_blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinate_space",
            "suggested_road_width_normalized",
            "routes",
            "notes"
          ],
          "properties": {
            "coordinate_space": { "type": "string", "const": "normalized_0_1" },
            "suggested_road_width_normalized": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 },
            "routes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/route" }
            },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "slot_strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "preferred_zones", "avoid_zones"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "preferred_zones": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "avoid_zones": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "semantic_hooks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "hazard", "defense", "blocking"],
          "properties": {
            "resource": { "$ref": "#/$defs/semantic_rule" },
            "hazard": { "$ref": "#/$defs/semantic_rule" },
            "defense": { "$ref": "#/$defs/semantic_rule" },
            "blocking": { "$ref": "#/$defs/semantic_rule" }
          }
        },
        "usage_policy": {
          "type": "array",
          "minItems": 2,
          "allOf": [
            { "contains": { "const": "developer_side_candidate_only" } },
            { "contains": { "const": "not_runtime_fact_source" } }
          ],
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
