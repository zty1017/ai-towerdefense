{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/asset_compiler.v0.1.schema.json",
  "title": "CompiledAssetCandidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "lifecycle", "gameplay", "presentation", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": ["ephemeral", "session_blueprint", "stabilized_blueprint"]
    },
    "gameplay": {
      "$ref": "#/$defs/gameplay"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_type", "effect_blocks"],
      "properties": {
        "asset_type": {
          "type": "string",
          "enum": ["tower_blueprint", "support_item", "temporary_mod", "intel_asset"]
        },
        "base_stats": {
          "type": "object",
          "additionalProperties": true
        },
        "effect_blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect_block"
          }
        },
        "costs": {
          "type": "object",
          "additionalProperties": true
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "type_specific": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "effect_block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "short_description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string",
          "minLength": 1
        },
        "long_description": {
          "type": "string"
        },
        "icon_prompt": {
          "type": "string"
        },
        "animation_card_prompt": {
          "type": "string"
        },
        "visual_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rarity_hint": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "worldbook_id"],
      "properties": {
        "proposal_id": {
          "type": ["string", "null"]
        },
        "mode": {
          "type": "string",
          "enum": ["runtime_safe", "runtime_experimental", "studio_mode"]
        },
        "worldbook_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": ["string", "null"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "npc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "repaired"]
        },
        "simulation_report_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}

