{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/map_compilation_input.v0.1.schema.json",
  "title": "MapCompilationInput v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_id", "battle_config_path", "map_style_pack_path"],
  "properties": {
    "schema_version": {"const": "map_compilation_input.v0.1"},
    "input_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "battle_config_path": {"type": "string", "minLength": 1},
    "map_style_pack_path": {"type": "string", "minLength": 1},
    "visual_generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_handoff": {"type": "boolean"},
        "background_execution": {"type": "boolean"},
        "reviewed_texture_source_dir": {"type": "string", "minLength": 1},
        "reviewed_backdrop_source_dir": {"type": "string", "minLength": 1},
        "reviewed_component_source_dir": {"type": "string", "minLength": 1}
      }
    }
  }
}
