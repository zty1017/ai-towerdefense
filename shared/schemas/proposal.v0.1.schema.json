{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/proposal.v0.1.schema.json",
  "title": "Proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "title",
    "summary",
    "intended_asset_type",
    "expected_effect",
    "risk_level",
    "estimated_cost",
    "required_inputs",
    "known_tradeoffs",
    "player_prompt",
    "worldbook_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["runtime_safe", "runtime_experimental", "studio_mode"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "intended_asset_type": {
      "type": "string",
      "enum": ["tower_blueprint", "support_item", "temporary_mod", "intel_asset"]
    },
    "expected_effect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["damage", "control", "support", "scouting", "economy", "defense", "risk"]
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "unstable"]
    },
    "estimated_cost": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "required_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facility": {
          "type": ["string", "null"]
        },
        "knowledge_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "known_tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "player_prompt": {
      "type": "string",
      "minLength": 1
    },
    "worldbook_id": {
      "type": "string",
      "minLength": 1
    }
  }
}

