{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/provider_adapter_execution_receipt.v0.1.schema.json",
  "title": "ProviderAdapterExecutionReceipt v0.1",
  "description": "A review-only receipt for entering the provider adapter boundary after explicit authorization and before ProviderOutputEnvelope. The receipt may describe a fixture-backed redacted handoff; it is not a runtime activation or world mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_receipt_id",
    "created_at",
    "source",
    "authority",
    "execution",
    "output_contract",
    "retention_policy",
    "adapter_safety"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "provider_adapter_execution_receipt.v0.1" },
    "execution_receipt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "run_id",
        "schedule_item_id",
        "object_kind",
        "object_ref",
        "executor_request_id",
        "authorization_ref",
        "guard_id",
        "provider_mode",
        "provider_profile",
        "worker_id"
      ],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "schedule_item_id": { "type": "string", "minLength": 1 },
        "object_kind": { "type": "string", "minLength": 1 },
        "object_ref": { "type": "string", "minLength": 1 },
        "executor_request_id": { "type": "string", "minLength": 1 },
        "authorization_ref": { "type": "string", "minLength": 1 },
        "guard_id": { "type": "string", "minLength": 1 },
        "provider_mode": { "type": "string", "minLength": 1 },
        "provider_profile": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "note": { "type": ["string", "null"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "review_only",
        "provider_adapter_boundary_entered",
        "runtime_activation_allowed",
        "world_mutation_allowed",
        "player_visible"
      ],
      "properties": {
        "visibility": { "type": "string", "const": "internal_evidence" },
        "review_only": { "type": "boolean", "const": true },
        "provider_adapter_boundary_entered": { "type": "boolean", "const": true },
        "runtime_activation_allowed": { "type": "boolean", "const": false },
        "world_mutation_allowed": { "type": "boolean", "const": false },
        "player_visible": { "type": "boolean", "const": false }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mode",
        "authorization_ref",
        "provider_call_performed_by_receipt_builder",
        "requires_provider_output_envelope",
        "request_digest",
        "result_digest"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fixture_output_ready_for_envelope",
            "performed_redacted_live",
            "failed_redacted",
            "cancelled"
          ]
        },
        "mode": {
          "type": "string",
          "enum": ["fixture_backed_no_provider_call", "live_redacted_provider_call"]
        },
        "authorization_ref": { "type": "string", "minLength": 1 },
        "provider_call_performed_by_receipt_builder": { "type": "boolean" },
        "requires_provider_output_envelope": { "type": "boolean", "const": true },
        "request_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "result_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "finish_reason": { "type": ["string", "null"] },
        "redacted_summary": { "type": "string", "minLength": 1 }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_write_provider_output_envelope",
        "allowed_result_storage",
        "temporary_url_policy",
        "required_next_gates"
      ],
      "properties": {
        "must_write_provider_output_envelope": { "type": "boolean", "const": true },
        "allowed_result_storage": {
          "type": "string",
          "const": "provider_output_envelope_redacted_only"
        },
        "temporary_url_policy": {
          "type": "string",
          "const": "download_then_local_ref_only"
        },
        "required_next_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_body_storage",
        "provider_body_storage",
        "secret_storage",
        "temporary_url_policy",
        "executor_result_storage"
      ],
      "properties": {
        "prompt_body_storage": { "type": "string", "const": "forbidden" },
        "provider_body_storage": { "type": "string", "const": "forbidden" },
        "secret_storage": { "type": "string", "const": "forbidden" },
        "temporary_url_policy": { "type": "string", "const": "download_then_local_ref_only" },
        "executor_result_storage": { "type": "string", "const": "provider_output_envelope_redacted_only" }
      }
    },
    "adapter_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads_env",
        "calls_provider",
        "stores_prompt_body",
        "stores_provider_body",
        "writes_world_state",
        "activates_runtime"
      ],
      "properties": {
        "reads_env": { "type": "boolean" },
        "calls_provider": { "type": "boolean" },
        "stores_prompt_body": { "type": "boolean", "const": false },
        "stores_provider_body": { "type": "boolean", "const": false },
        "writes_world_state": { "type": "boolean", "const": false },
        "activates_runtime": { "type": "boolean", "const": false }
      }
    }
  }
}
