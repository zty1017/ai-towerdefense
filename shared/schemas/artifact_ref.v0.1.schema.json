{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/artifact_ref.v0.1.schema.json",
  "title": "ArtifactRef v0.1",
  "description": "A reference to an artifact file produced or consumed by a node. The ref carries no large payload on the edge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "kind", "path"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "media_layer": {
      "type": "string",
      "enum": ["raw_media", "processed_media", "published_media"],
      "description": "Only set for media artifacts. Published_media is the only layer allowed in runtime_public artifacts."
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_type": { "type": "string" },
    "byte_size": { "type": "integer", "minimum": 0 },
    "produced_by_node": { "type": "string" },
    "produced_at": { "type": "string" }
  }
}
