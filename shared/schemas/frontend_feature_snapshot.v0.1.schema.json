{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/frontend_feature_snapshot.v0.1.schema.json",
  "title": "FrontendFeatureSnapshot v0.1",
  "description": "Stable player-facing projection for one registered frontend feature. The snapshot is consumed only after its parent runtime bundle is activated and runtime-safe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "surface",
    "status",
    "required_gates",
    "consumes",
    "contributions"
  ],
  "properties": {
    "schema_version": { "const": "frontend_feature_snapshot.v0.1" },
    "feature_id": {
      "type": "string",
      "enum": ["strategic_map", "workshop", "battle", "narrative", "settlement"]
    },
    "surface": {
      "type": "string",
      "enum": ["strategic_map", "prototype_workshop", "battle_canvas", "dialogue_modal", "settlement_panel"]
    },
    "status": { "type": "string", "enum": ["active", "degraded", "disabled", "quarantined"] },
    "required_gates": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
      "uniqueItems": true
    },
    "consumes": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$" },
      "uniqueItems": true
    },
    "contributions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "https://ai-compiled-towerdefense.local/schemas/frontend_surface_contribution.v0.1.schema.json"
      }
    },
    "degradation_notice": { "type": ["string", "null"], "maxLength": 360 }
  },
  "allOf": [
    { "if": { "properties": { "feature_id": { "const": "strategic_map" } } }, "then": { "properties": { "surface": { "const": "strategic_map" } } } },
    { "if": { "properties": { "feature_id": { "const": "workshop" } } }, "then": { "properties": { "surface": { "const": "prototype_workshop" } } } },
    { "if": { "properties": { "feature_id": { "const": "battle" } } }, "then": { "properties": { "surface": { "const": "battle_canvas" } } } },
    { "if": { "properties": { "feature_id": { "const": "narrative" } } }, "then": { "properties": { "surface": { "const": "dialogue_modal" } } } },
    { "if": { "properties": { "feature_id": { "const": "settlement" } } }, "then": { "properties": { "surface": { "const": "settlement_panel" } } } }
  ]
}
