{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-compiled-towerdefense.local/schemas/frontend_mock_pack.v0.1.schema.json",
  "title": "FrontendMockPack v0.1",
  "description": "Player-safe content package for frontend/backend parallel development. It embeds compiled playable assets, world/map/npc/story fixtures, fallback media tokens, and compiler summary without provider/prompt/raw trace fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "created_at",
    "worldbook_id",
    "compiler_summary",
    "frontend_contract",
    "world",
    "map",
    "npcs",
    "materials",
    "story",
    "assets"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "frontend_mock_pack.v0.1" },
    "pack_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "worldbook_id": { "type": "string", "minLength": 1 },
    "compiler_summary": { "type": "object" },
    "frontend_contract": { "type": "object" },
    "world": { "type": "object" },
    "map": { "type": "object" },
    "npcs": { "type": "array", "items": { "type": "object" } },
    "materials": { "type": "array", "items": { "type": "object" } },
    "story": { "type": "object" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stable_internal_id",
          "asset_type",
          "lifecycle",
          "display",
          "gameplay",
          "visual_recipes",
          "media_refs",
          "promotion",
          "compiler_reports",
          "frontend_usage"
        ],
        "properties": {
          "stable_internal_id": { "type": "string", "minLength": 1 },
          "asset_type": { "type": "string", "minLength": 1 },
          "lifecycle": { "type": "string", "minLength": 1 },
          "display": { "type": "object" },
          "gameplay": { "type": "object" },
          "visual_recipes": { "type": "array", "items": { "type": "object" } },
          "media_refs": { "type": "object" },
          "promotion": { "type": "object" },
          "compiler_reports": { "type": "object" },
          "frontend_usage": { "type": "object" }
        }
      }
    }
  }
}
